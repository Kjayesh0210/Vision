{
  "info": {
    "name": "Railway AI Block Planning",
    "description": "Backend (Express, :5000) -> ML engine (Python, :8000).\n\nStart both servers first:\n  python Vision/ML/api_server.py 8000\n  cd Vision/Backend && npm run dev\n\nRun '1. Create block request' first: it stores {{requestId}} for the other Block Request calls.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api"
    },
    {
      "key": "mlUrl",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "requestId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Backend health",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/health"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "ML engine health (via backend)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ai/health",
            "description": "503 here means the Python ML server is not running."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Block Requests (form -> ML -> DB)",
      "item": [
        {
          "name": "1. Create block request",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/block-requests",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"department\": \"Engineering\",\n  \"maintenanceType\": \"Track Maintenance\",\n  \"priority\": \"MEDIUM\",\n  \"sectionId\": \"LNL-PUNE\",\n  \"fromLocation\": \"Lonavala\",\n  \"toLocation\": \"Pune\",\n  \"fromKm\": 45.0,\n  \"toKm\": 52.0,\n  \"assetId\": \"AST027697\",\n  \"submittedBy\": \"SSE/P-Way Lonavala\",\n  \"schedulingPreferences\": {\n    \"preferredDate\": \"16/09/2026\",\n    \"durationHours\": 3,\n    \"preferredStartTime\": \"01:00 AM\",\n    \"preferredEndTime\": \"05:00 AM\"\n  },\n  \"resources\": {\n    \"workersRequired\": 10,\n    \"equipmentRequired\": [\n      \"Tamping Machine\"\n    ],\n    \"additionalNotes\": \"Ballast tamping, track alignment, and joint inspection on Up-line\"\n  },\n  \"canBeCombined\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Remove requestId from the body to let the backend generate one. assetId is optional (adds the stored ML risk score)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.requestId) {",
                  "  pm.collectionVariables.set('requestId', json.data.requestId);",
                  "}",
                  "pm.test('Has recommended window', () => pm.expect(json.data.decision.recommendedWindow).to.be.an('object'));",
                  "pm.test('Shadow block saved hours > 0', () => pm.expect(json.data.decision.multiDepartmentCoordination.downtimeSavedHours).to.be.above(0));"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Get block request",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ai/block-requests/{{requestId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "3. Pick alternative window",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/block-requests/{{requestId}}/window",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionId\": \"ALTERNATIVE_1\",\n  \"by\": \"Section Controller\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "optionId: RECOMMENDED, ALTERNATIVE_1 or ALTERNATIVE_2."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Accept block request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/block-requests/{{requestId}}/decision",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"accepted\",\n  \"by\": \"DRM\",\n  \"note\": \"Approved for 16 Sep night block\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Reject block request",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/block-requests/{{requestId}}/decision",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"decision\": \"rejected\",\n  \"by\": \"DRM\",\n  \"note\": \"Clashes with special train\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "6. List block requests",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ai/block-requests?status=accepted&sectionId=LNL-PUNE&limit=20",
            "description": "Filters are optional: status (recommended | needs_review | accepted | rejected), sectionId, limit."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "Validation error (empty body)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/block-requests",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown alternative",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/ai/block-requests/{{requestId}}/window",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"optionId\": \"NOPE\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 400\", () => pm.response.to.have.status(400));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "AI Engine (pass-through, not saved)",
      "item": [
