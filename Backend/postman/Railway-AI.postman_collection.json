        {
          "name": "KPIs (before vs after)",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/ai/kpis"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "ML Data (imported CSV outputs)",
      "item": [
        {
          "name": "Import ML outputs into MongoDB",
          "request": {
            "method": "POST",
            "header": [],
            "url": "{{baseUrl}}/ml/import",
            "description": "Already done once. Takes ~3 minutes; re-run only when the ML CSVs change."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));"
